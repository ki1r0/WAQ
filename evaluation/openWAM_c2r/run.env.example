# Copy this file to run.env and replace every placeholder. Do not commit run.env.
export WAQ_ROOT=/path/to/WAQ

# These paths must exist on every worker node.
export OPENWAM_REPO=/path/to/OpenWAM
export ROBOTWIN_ROOT=/path/to/RoboTwin
export OPENWAM_PYTHON=/path/to/openwam-env/bin/python
export ROBOTWIN_PYTHON=/path/to/robotwin-env/bin/python

# The actor and critic are external artifacts; their directories/files are not in WAQ.
export OPENWAM_SFT_DIR=/path/to/actor-checkpoint-directory
export OPENWAM_SFT_NAME=checkpoint_step_5000.safetensors
export OPENWAM_Q_CHECKPOINT=/path/to/checkpoint_step_7266.safetensors

# Must be the same absolute shared path on all worker nodes.
export OPENWAM_C2R_RUN_ROOT=/shared/path/openwam-c2r-run-001

# Recorded default topology and evaluation target.
export OPENWAM_C2R_NODE_COUNT=6
export OPENWAM_C2R_GPUS_PER_NODE=8
export OPENWAM_C2R_EPISODES_PER_TASK=100

# Optional overrides; defaults point to the files bundled beside the queue.
# export ROBOTWIN_TASK_LIST=/path/to/WAQ/evaluation/openWAM_c2r/tasks.txt
# export ROBOTWIN_SOURCE_OVERLAY=/path/to/WAQ/evaluation/openWAM_c2r/robotwin_source_overlay
# export OPENWAM_Q_ADAPTER=/path/to/WAQ/evaluation/openWAM_c2r/openwam_qguided_deploy.py
